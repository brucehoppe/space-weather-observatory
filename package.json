{
  "name": "space-weather-observatory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "description": "Follow the Sun. Understand its influence. A local, source-grounded desktop observatory for space weather.",
  "license": "MIT",
  "author": "Bruce Hoppe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brucehoppe/space-weather-observatory.git"
  },
  "keywords": [
    "space-weather",
    "solar-wind",
    "aurora",
    "noaa",
    "swpc",
    "tauri",
    "desktop"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/chart.test.ts src/chart-export.test.ts src/format.test.ts src/replay.test.ts",
    "tauri": "tauri",
    "build:macos-zip": "tauri build --bundles app && cd \"target/release/bundle/macos\" && rm -f \"Space Weather Observatory.app.zip\" && ditto -c -k --sequesterRsrc --keepParent \"Space Weather Observatory.app\" \"Space Weather Observatory.app.zip\"",
    "build:windows": "pwsh -File scripts/build-windows.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-opener": "2.5.5",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/topojson-client": "3.1.5",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
